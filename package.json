{
  "name": "dsh-speak",
  "version": "1.7.1",
  "description": "Make your AI harness speak — voice announcements for DSH and other AI coding harnesses (Windows SAPI5 + macOS system voices)",
  "main": "adapters/dsh/speech-hook.js",
  "exports": {
    ".": "./adapters/dsh/speech-hook.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "adapters/dsh/speech-hook.js",
    "adapters/dsh/install.ps1",
    "cordis.patch.yml",
    "client/",
    "engine/",
    "docs/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tts",
    "text-to-speech",
    "voice",
    "speech",
    "voice-announcement",
    "sapi5",
    "windows",
    "powershell",
    "macos",
    "darwin",
    "say"
  ],
  "scripts": {
    "prepublishOnly": "node --check adapters/dsh/speech-hook.js && node --check client/client.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alan2Z/dsh-speak.git"
  },
  "author": "Alan2Z",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
