{
  "name": "dsh-speak",
  "version": "1.4.0",
  "description": "Make your AI harness speak — verified voice announcements for DSH and other AI coding harnesses (Windows SAPI5 + macOS system voices)",
  "main": "adapters/dsh/speech-hook.js",
  "files": [
